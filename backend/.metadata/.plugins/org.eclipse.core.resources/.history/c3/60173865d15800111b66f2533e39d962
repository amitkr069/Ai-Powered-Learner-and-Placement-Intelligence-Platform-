package com.backend.learner_placement.services;

import java.util.List;

import javax.management.RuntimeErrorException;

import org.modelmapper.ModelMapper;
import org.springframework.stereotype.Service;

import com.backend.learner_placement.dtos.AssessmentDto;
import com.backend.learner_placement.models.Assessment;
import com.backend.learner_placement.models.Learner;
import com.backend.learner_placement.repository.AssessmentRepository;
import com.backend.learner_placement.repository.LearnerRepository;

@Service
public class AssessmentService {

	private AssessmentRepository assessmentRepositroy;
	private LearnerRepository learnerRepository;
	private ModelMapper modelMapper;
	
	public AssessmentService(AssessmentRepository assessmentRepositroy, LearnerRepository learnerRepository, ModelMapper modelMapper) {
		this.assessmentRepositroy = assessmentRepositroy;
		this.learnerRepository = learnerRepository;
		this.modelMapper = modelMapper;
	}
	
	public AssessmentDto createAssessment(AssessmentDto assessmentDto) {
		Learner learner = learnerRepository.findById(assessmentDto.getLearnerId()).
				orElseThrow(() -> new RuntimeException("Learner not found"));
		Assessment assessment = modelMapper.map(assessmentDto, Assessment.class);
		Assessment savedAssessment = assessmentRepositroy.save(assessment);
		AssessmentDto responseDto = modelMapper.map(savedAssessment, AssessmentDto.class);
		responseDto.setLearnerId(learner.getLearnerId()); 
		return responseDto; 
	}
	
	public List<AssessmentDto> getAssessmentByLearnerId(Long learnerId){
		return assessmentRepositroy.findByLearner_LearnerId(learnerId).
				stream().
				map((Assessment assessment) -> {
					AssessmentDto assessmentDto = modelMapper.map(assessment, AssessmentDto.class);
					assessmentDto.setLearnerId(assessment.getLearner().getLearnerId());
					return assessmentDto;
				}).toList(); 
	}
	
	public AssessmentDto updateAssessment(Long assessmentId, AssessmentDto assessmentDto) {
		Assessment exist = assessmentRepositroy.findById(assessmentId).
				orElseThrow(() -> new RuntimeException("Assessment not found with id : "+assessmentId));
		
		// only score and type updation
		exist.setScore(assessmentDto.getScore());
		exist.setType(assessmentDto.getType());
		
		Assessment updatedAssessment = assessmentRepositroy.save(exist);
		AssessmentDto responseDto = modelMapper.map(updatedAssessment, AssessmentDto.class);
		responseDto.setLearnerId(exist.getLearner().getLearnerId());
		return responseDto;
	}
	
	public void deleteAssessment(Long assessmentId) {
		if(!assessmentRepositroy.existsById(assessmentId)) {
			throw new RuntimeException("No assessment found with id : "+assessmentId);
		}
		assessmentRepositroy.deleteById(assessmentId);
	}
	
}
